# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==============================================================================
# FIREBASE CONFIGURATION (SECRETS & ENVIRONMENT VARIABLES)
# ==============================================================================
# Configure these variables in Google AI Studio Secrets or your deployment environment.
# No secrets or actual values should be committed to this file.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional DEV environment overrides (loaded in DEV mode)
# FIREBASE_DEV_API_KEY=
# FIREBASE_DEV_AUTH_DOMAIN=
# FIREBASE_DEV_DATABASE_URL=
# FIREBASE_DEV_PROJECT_ID=
# FIREBASE_DEV_STORAGE_BUCKET=
# FIREBASE_DEV_MESSAGING_SENDER_ID=
# FIREBASE_DEV_APP_ID=

